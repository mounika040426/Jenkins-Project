pipeline {
  agent any 
   
    stages {
     stage ('Checkout') {
          steps {
                 git 'https://github.com/mounika040426/Jenkins-Project.git'
                 }
            }
     stage ('Build') {
          steps {
                 echo 'BUild started'
                 }
            }
     stage ('Test') {
          steps {
                 echo 'Testing the application.........'
                 }
             }
     stage ('Docker Build') {
          steps { 
                sh 'docker build -t my-devops-app .'
                }
             }   
     stage ('Docker Run') {
          steps {
                 sh 'docker run -d --name my-devops-container -p 8080:80 my-devops-app'
                 }
              }
      }
      post {
           success {
                  echo 'Pipeline completed successfully!'
                  }
           failure {
                  echo 'Pipeline failed. Check the logs!'
                  }
             }
            } 
                 
   
